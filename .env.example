# ---------------------------------------------------------------
# TrustOS pilot — environment template
# Copy to .env for local development. NEVER commit .env.
#
# NOTE: This application uses custom JWT authentication built on
# `jose`. It does NOT use NextAuth. The AUTH_SECRET variable is a
# plain HS256 signing key, not a NextAuth secret.
# ---------------------------------------------------------------

# REQUIRED — Pooled DB URL for the app (serverless runtime).
# Supabase: Transaction pooler host …pooler.supabase.com:6543
#   Prefer: ?pgbouncer=true&connection_limit=1&sslmode=require
# Do NOT point this at session-mode :5432 — that causes EMAXCONNSESSION.
DATABASE_URL=""

# REQUIRED for migrations — direct / session URL (prisma migrate deploy).
# Supabase: db.<project>.supabase.co:5432 (or Session mode URI).
# Runtime Prisma must NOT use this (see src/lib/prisma.ts).
# Set this in Vercel/Netlify BUILD env so `npm run build` can migrate.
# If unset, build skips migrate and still runs generate + next build.
DIRECT_URL=""

# REQUIRED — JWT signing key. Generate with: openssl rand -base64 32
# Must be set in the Netlify BUILD environment as well as runtime.
# There is no fallback. NEXTAUTH_SECRET is no longer read.
AUTH_SECRET=""

# REQUIRED — Public base URL of this deployment (no trailing slash)
APP_URL="http://localhost:3000"

# OPTIONAL — Stripe test mode. Payments are disabled if unset.
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# SEED ONLY — all four required by `npm run db:seed`, which throws if
# any is absent. Set them on the seed command only. Do NOT add to Netlify.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_VENDOR_EMAIL=""
SEED_VENDOR_PASSWORD=""

# OPTIONAL — exposes /api/health detail to requests carrying this token
HEALTH_TOKEN=""
